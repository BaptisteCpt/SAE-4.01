generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prismaBati"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model modelemaison {
  nomodele          Int    @id
  nommodele         String
  descriptionmodele String

  @@map("Bati_Parti.nom_table")
}
